# Doorstep Resolve Environment Configuration
# Copy this file to .env and configure your secret credentials.
# The .env file is git-ignored and never committed.

# Provider selection: 'mock' (default offline testing) or 'openai' (live OpenAI API)
DOORSTEP_LLM_PROVIDER=openai

# OpenAI API Key (project-scoped key recommended: sk-proj-...)
# NEVER commit your real key or paste it into shared chats.
OPENAI_API_KEY=your_openai_api_key_here

# OpenAI Model: defaults to gpt-6-luna ($0.10/1M input, $0.50/1M output)
OPENAI_MODEL=gpt-6-luna

# Streamable HTTP MCP Server URL (defaults to http://127.0.0.1:8000/mcp)
DOORSTEP_MCP_SERVER_URL=http://127.0.0.1:8000/mcp
